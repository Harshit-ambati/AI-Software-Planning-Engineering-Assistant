# Copy to .env at the repository root. Demo makes no model calls.
AI_PROVIDER=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Local Qdrant storage by default; set URL for the optional Docker service.
QDRANT_URL=
DATA_DIR=./data
# Optional single-user bearer token. Required before exposing beyond localhost.
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
